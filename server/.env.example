# ---------------------------------------------------------------------------
# NOC Ticket Management System - server environment
# Copy this file to `server/.env` and adjust. Every value below has a working
# default, so the app also boots with no .env file at all.
# ---------------------------------------------------------------------------

# HTTP port for the Express API
PORT=5000

NODE_ENV=development

# --- Database -------------------------------------------------------------
# Point this at your own MongoDB (local or Atlas), e.g.
#   MONGODB_URI=mongodb://127.0.0.1:27017/noc_system
#   MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/noc_system
# If MONGODB_URI is left empty the server starts an EMBEDDED MongoDB instance
# and stores its data under server/.data/mongo (no manual install needed).
MONGODB_URI=

# Set to "false" to disable the embedded-MongoDB fallback and fail fast instead.
USE_EMBEDDED_MONGO=true

# Port used by the embedded MongoDB instance
EMBEDDED_MONGO_PORT=27018

# --- Authentication -------------------------------------------------------
# CHANGE THIS IN PRODUCTION. Must be a long random string.
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# --- App behaviour --------------------------------------------------------
# IANA timezone used for every ticket/invoice date rendered by the server.
APP_TIMEZONE=Asia/Karachi

# First ticket number issued by the server-side TID sequence.
TICKET_NUMBER_START=4626

# Company details printed on invoice PDFs
COMPANY_NAME=NOC Network Services
COMPANY_ADDRESS=Gajjumata, Lahore, Pakistan
COMPANY_PHONE=0333-4458420
COMPANY_EMAIL=billing@noc-network.local
INVOICE_CURRENCY=PKR
INVOICE_DUE_DAYS=15
INVOICE_TAX_PERCENT=0

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI assistant (optional) ---------------------------------------------
# Server-side only. NEVER put this key in the React/client code.
# Without a key the AI analysis is skipped gracefully (status = "unavailable")
# and ticket creation still succeeds.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_ENABLED=true
AI_TIMEOUT_MS=30000

# --- Seed accounts --------------------------------------------------------
SEED_ADMIN_EMAIL=admin@noc.local
SEED_ADMIN_PASSWORD=Admin@123
