# ---------------------------------------------------------------------------
# NOC Ticket Management System - server environment
# Copy this file to `server/.env` and adjust. Every value below has a working
# default, so the app also boots with no .env file at all.
# ---------------------------------------------------------------------------

# HTTP port for the Express API
PORT=5000

NODE_ENV=development

# --- Database -------------------------------------------------------------
# Point this at your own MongoDB (local or Atlas), e.g.
#   MONGODB_URI=mongodb://127.0.0.1:27017/noc_system
#   MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/noc_system
# If MONGODB_URI is left empty the server starts an EMBEDDED MongoDB instance
# and stores its data under server/.data/mongo (no manual install needed).
MONGODB_URI=

# Set to "false" to disable the embedded-MongoDB fallback and fail fast instead.
USE_EMBEDDED_MONGO=true

# Port used by the embedded MongoDB instance
EMBEDDED_MONGO_PORT=27018

# --- Authentication -------------------------------------------------------
# CHANGE THIS IN PRODUCTION. Must be a long random string.
JWT_SECRET=change-me-to-a-long-random-secret-string
# Sign the user out after this many minutes without activity.
SESSION_IDLE_MINUTES=5
BCRYPT_ROUNDS=10

# --- App behaviour --------------------------------------------------------
# IANA timezone used for every ticket/invoice date rendered by the server.
APP_TIMEZONE=Asia/Karachi

# First ticket number issued by the server-side TID sequence.
TICKET_NUMBER_START=4626

# Fallback name only. Every client's invoices, quotations and bill slips use
# that client's own letterhead (name, logo, address) from its Settings page.
COMPANY_NAME=NOC Panel
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_TAGLINE=
INVOICE_CURRENCY=PKR
INVOICE_DUE_DAYS=15
INVOICE_TAX_PERCENT=0
INVOICE_WITHHOLDING_TAX_PERCENT=0

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI assistant (optional) ---------------------------------------------
# Server-side only. NEVER put these keys in the React/client code.
# Without a key the AI analysis is skipped gracefully (status = "unavailable")
# and ticket creation still succeeds.
#
# Which backend to use: "openrouter" or "anthropic".
# Defaults to openrouter when OPENROUTER_API_KEY is set, otherwise anthropic.
AI_PROVIDER=openrouter

# OpenRouter key from https://openrouter.ai/keys ("sk-or-v1-..." — the server
# adds that prefix for you if you paste the bare key).
OPENROUTER_API_KEY=

# Model slug. The default "openrouter/free" auto-picks whichever free model is
# live, so it keeps working when individual free models are retired.
AI_MODEL=openrouter/free

# Used only when AI_PROVIDER=anthropic (AI_MODEL then defaults to claude-opus-5).
ANTHROPIC_API_KEY=

AI_ENABLED=true
AI_TIMEOUT_MS=60000

# --- Seed accounts --------------------------------------------------------
SEED_ADMIN_NAME=Panel Owner
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@noc.local
SEED_ADMIN_PASSWORD=Admin@123
